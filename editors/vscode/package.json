{
    "name": "forge",
    "displayName": "Forge",
    "description": "Forge (.frg) game language: syntax colors, errors as you save, autocomplete for the built-in libraries, and a Run button.",
    "version": "0.8.1",
    "publisher": "forge-lang",
    "license": "MIT",
    "icon": "icons/forge-128.png",
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Programming Languages",
        "Snippets"
    ],
    "main": "./extension.js",
    "activationEvents": [
        "onLanguage:forge"
    ],
    "contributes": {
        "languages": [
            {
                "id": "forge",
                "aliases": [
                    "Forge",
                    "forge"
                ],
                "extensions": [
                    ".frg"
                ],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "./icons/frg.svg",
                    "dark": "./icons/frg.svg"
                }
            }
        ],
        "grammars": [
            {
                "language": "forge",
                "scopeName": "source.forge",
                "path": "./syntaxes/forge.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "forge",
                "path": "./snippets/forge.json"
            }
        ],
        "commands": [
            {
                "command": "forge.run",
                "title": "Forge: Run Game",
                "icon": "$(play)"
            },
            {
                "command": "forge.debug",
                "title": "Forge: Debug Game (breakpoints and variables)",
                "icon": "$(debug-alt)"
            },
            {
                "command": "forge.test",
                "title": "Forge: Run Tests (the game's tests folder)",
                "icon": "$(beaker)"
            },
            {
                "command": "forge.build",
                "title": "Forge: Build Game",
                "icon": "$(tools)"
            },
            {
                "command": "forge.check",
                "title": "Forge: Check for Errors"
            },
            {
                "command": "forge.buildRelease",
                "title": "Forge: Build Release (finished game, no console)"
            },
            {
                "command": "forge.package",
                "title": "Forge: Package Game (zip it, ready to share)"
            },
            {
                "command": "forge.toggleConsole",
                "title": "Forge: Turn the Console On/Off"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "forge.run",
                    "when": "resourceLangId == forge",
                    "group": "navigation"
                },
                {
                    "command": "forge.debug",
                    "when": "resourceLangId == forge",
                    "group": "navigation"
                }
            ]
        },
        "keybindings": [
            {
                "command": "forge.run",
                "key": "f5",
                "when": "editorLangId == forge && !inDebugMode"
            },
            {
                "command": "forge.build",
                "key": "ctrl+shift+b",
                "when": "editorLangId == forge"
            },
            {
                "command": "forge.debug",
                "key": "f6",
                "when": "editorLangId == forge && !inDebugMode"
            }
        ],
        "configuration": {
            "title": "Forge",
            "properties": {
                "forge.path": {
                    "type": "string",
                    "default": "",
                    "description": "Full path to frg.exe. Leave empty to use the one Forge was installed with, or the one on your PATH."
                },
                "forge.console": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show a console window next to the game when it's run or built from VS Code, so print() output and errors can be seen. Turn it off to try the game the way players will see it. Forge: Build Release never has a console."
                },
                "forge.checkOnSave": {
                    "type": "boolean",
                    "default": true,
                    "description": "Look for errors every time a .frg file is saved."
                }
            }
        },
        "breakpoints": [
            {
                "language": "forge"
            }
        ]
    }
}
