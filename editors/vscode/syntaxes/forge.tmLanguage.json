{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Forge",
    "scopeName": "source.forge",
    "patterns": [
        { "include": "#comments" },
        { "include": "#include-directive" },
        { "include": "#type-declaration" },
        { "include": "#keywords" },
        { "include": "#raw-strings" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#builtin-types" },
        { "include": "#libraries" },
        { "include": "#functions" },
        { "include": "#properties" },
        { "include": "#constants" },
        { "include": "#user-types" },
        { "include": "#operators" },
        { "include": "#punctuation" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.block.forge",
                    "begin": "```",
                    "end": "```",
                    "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.forge" } },
                    "endCaptures": { "0": { "name": "punctuation.definition.comment.end.forge" } }
                },
                {
                    "name": "comment.line.double-slash.forge",
                    "begin": "//",
                    "end": "$",
                    "beginCaptures": { "0": { "name": "punctuation.definition.comment.forge" } }
                }
            ]
        },
        "include-directive": {
            "match": "^\\s*(#include)\\s*(<)\\s*(?:(\"[^\"]*\")|([A-Za-z_][A-Za-z0-9_]*))\\s*(>)",
            "captures": {
                "1": { "name": "keyword.control.directive.include.forge" },
                "2": { "name": "punctuation.definition.directive.forge" },
                "3": { "name": "string.quoted.double.include.forge" },
                "4": { "name": "entity.name.namespace.forge" },
                "5": { "name": "punctuation.definition.directive.forge" }
            }
        },
        "type-declaration": {
            "match": "\\b(struct|class|enum|interface)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s*(:)\\s*([A-Za-z_][A-Za-z0-9_.]*))?",
            "captures": {
                "1": { "name": "storage.type.forge" },
                "2": { "name": "entity.name.type.forge" },
                "3": { "name": "punctuation.separator.inheritance.forge" },
                "4": { "name": "entity.other.inherited-class.forge" }
            }
        },
        "keywords": {
            "patterns": [
                { "name": "keyword.control.forge", "match": "\\b(if|else|while|do|for|in|switch|case|default|return|break|continue|try|catch|throw|wait)\\b" },
                { "name": "keyword.operator.logical.forge", "match": "\\b(and|or|not)\\b" },
                { "name": "keyword.operator.type.forge", "match": "\\b(is|as)\\b" },
                { "name": "keyword.operator.word.forge", "match": "(?<=[\\w\\)\\]\"]\\s{1,8})\\b(plus|minus|times|div|mod|equals|greater|less|otherwise|bitand|bitor|bitxor|shiftleft|shiftright)\\b(?!\\s*=(?!=))(?=\\s)" },
                { "name": "keyword.operator.word.forge", "match": "\\b(negative|bitnot)\\b|(?<=\\bor\\s{1,8})\\bequal\\b" },
                {
                    "match": "^\\s*(set|increase|decrease|multiply|divide)\\s+(?=[A-Za-z_])",
                    "captures": { "1": { "name": "keyword.operator.word.forge" } }
                },
                { "name": "keyword.operator.word.forge", "match": "(?<=[\\w\\)\\]]\\s{1,8})\\b(to|by)\\b(?=\\s)" },
                { "name": "storage.type.forge", "match": "\\b(struct|class|enum|interface)\\b" },
                { "name": "storage.modifier.forge", "match": "\\b(const|static|abstract|private|public)\\b" },
                { "name": "variable.language.forge", "match": "\\b(this|super)\\b" },
                { "name": "constant.language.forge", "match": "\\b(true|false|null)\\b" }
            ]
        },
        "raw-strings": {
            "name": "string.quoted.triple.forge",
            "begin": "\"\"\"",
            "end": "\"\"\"",
            "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.forge" } },
            "endCaptures": { "0": { "name": "punctuation.definition.string.end.forge" } }
        },
        "strings": {
            "name": "string.quoted.double.forge",
            "begin": "\"",
            "end": "\"",
            "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.forge" } },
            "endCaptures": { "0": { "name": "punctuation.definition.string.end.forge" } },
            "patterns": [
                { "name": "constant.character.escape.forge", "match": "\\\\[ntr\\\\\"'{}]|\\{\\{|\\}\\}" },
                { "name": "invalid.illegal.escape.forge", "match": "\\\\." },
                {
                    "name": "meta.interpolation.forge",
                    "begin": "\\{",
                    "end": "\\}",
                    "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.forge" } },
                    "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.forge" } },
                    "contentName": "source.forge.embedded",
                    "patterns": [{ "include": "$self" }]
                }
            ]
        },
        "numbers": {
            "name": "constant.numeric.forge",
            "match": "\\b(?:0[xX][0-9A-Fa-f_]+|0[bB][01_]+|[0-9][0-9_]*(?:\\.[0-9][0-9_]*)?(?:[eE][+-]?[0-9]+)?)\\b"
        },
        "builtin-types": {
            "name": "storage.type.built-in.forge",
            "match": "\\b(void|task|bool|string|int|int8|int16|int32|int64|int128|uint|uint8|uint16|uint32|uint64|uint128|float|double|list|map|Function|Weak|vec2|vec3|vec4|color|rect)\\b"
        },
        "libraries": {
            "name": "support.class.library.forge",
            "match": "\\b(stdio|math|window|input|graphics2d|graphics3d|physics|random|assets|audio|time|file|scenes|ui|ECS|tasks|OpenGL|DirectX|Vulkan)\\b(?=\\s*\\.)"
        },
        "functions": {
            "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
            "captures": { "1": { "name": "entity.name.function.forge" } }
        },
        "properties": {
            "match": "(?<=\\.)\\s*([a-z_][A-Za-z0-9_]*)\\b",
            "captures": { "1": { "name": "variable.other.property.forge" } }
        },
        "constants": {
            "name": "variable.other.constant.forge",
            "match": "\\b[A-Z][A-Z0-9_]*\\b"
        },
        "user-types": {
            "name": "entity.name.type.forge",
            "match": "\\b[A-Z][A-Za-z0-9_]*[a-z][A-Za-z0-9_]*\\b"
        },
        "operators": {
            "patterns": [
                { "name": "keyword.operator.assignment.compound.forge", "match": "\\+=|-=|\\*=|/=|%=" },
                { "name": "keyword.operator.comparison.forge", "match": "==|!=|<=|>=" },
                { "name": "keyword.operator.logical.forge", "match": "&&|\\|\\||!(?!=)|\\?\\?" },
                { "name": "keyword.operator.increment.forge", "match": "\\+\\+|--" },
                { "name": "keyword.operator.bitwise.forge", "match": "<<|>>|&|\\||\\^|~" },
                { "name": "keyword.operator.arithmetic.forge", "match": "[-+*/%]" },
                { "name": "keyword.operator.assignment.forge", "match": "=" },
                { "name": "keyword.operator.comparison.forge", "match": "<|>" },
                { "name": "keyword.operator.ternary.forge", "match": "\\?|:" }
            ]
        },
        "punctuation": {
            "patterns": [
                { "name": "punctuation.terminator.statement.forge", "match": ";" },
                { "name": "punctuation.separator.comma.forge", "match": "," },
                { "name": "punctuation.accessor.forge", "match": "\\." }
            ]
        }
    }
}
