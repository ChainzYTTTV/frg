=== main.frg
#include <stdio>
#include <assets>

int main(){
    Texture sheet = assets.loadTexture("sheet.png");
    Animation walk = Animation(sheet, 16, 16, 4, 10);
    print(walk);
    walk.update(0.05);
    print(walk.frame());
    walk.update(0.06);
    print(walk.frame());
    walk.update(0.25);
    print(walk.frame());
    walk.update(0.1);
    print(walk.frame());

    walk.pause();
    walk.update(1);
    print("{walk.frame()} {walk.isPlaying()}");
    walk.play();
    walk.reset();
    print("{walk.frame()} {walk.isPlaying()}");

    walk.looping = false;
    walk.update(10);
    print("{walk.frame()} {walk.isDone()}");
    walk.setFrame(1);
    walk.flip(true);
    print("{walk.frame()} {walk.isFlipped()} {walk.frameCount()}");
    walk.fps = 0;
    walk.update(5);
    print(walk.frame());
    return 0;
}
