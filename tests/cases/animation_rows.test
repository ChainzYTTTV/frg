=== main.frg
#include <stdio>
#include <assets>

// sheet.png is 32 x 32: two rows of two 16 x 16 frames. The run animation is the second row.
int main(){
    Texture sheet = assets.loadTexture("sheet.png");
    Animation idle = Animation(sheet, 16, 16, 2, 4);
    Animation run = Animation(sheet, 16, 16, 2, 4, 1);
    run.update(0.3);
    print("{idle.frame()} {run.frame()}");
    Animation tooLong = Animation(sheet, 16, 16, 3, 4, 1);
    return 0;
}
