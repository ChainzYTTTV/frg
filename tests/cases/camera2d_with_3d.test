=== main.frg
#include <window>
#include <graphics2d>
#include <graphics3d>

``` Both cameras in one game: the 3D Camera3D and the 2D Camera2D are different types. ```
vec2 target = vec2(0, 0);

void update(float dt) {
    target = target.lerp(vec2(500, 0), 5 * dt);
}

void draw() {
    graphics3d.setCamera(Camera3D(vec3(0, 5, 10), vec3(0, 0, 0)));
    graphics3d.drawCube(vec3(0, 0, 0), vec3(1, 1, 1), color.RED);
    graphics2d.setCamera(Camera2D(target, vec2(480, 270), 1.5));
    graphics2d.drawRect(0, 0, 50, 50, color.BLUE);
    graphics2d.resetCamera();
    graphics2d.drawText("Score", 10, 10, 20, color.WHITE);
}

int main(){
    window.open(960, 540, "Cameras");
    window.run();
    return 0;
}
