#include <DirectX>
#include <stdio>

int main(){
    print(DirectX.TRIANGLES);
    print(DirectX.CULL_BACK);
    list<float> data = [];
    data.addAll(DirectX.identity());
    data.addAll([1, 2]);
    print(data.length);
    print(DirectX.perspective(90, 1, 1, 3)[10]);
    return 0;
}
