=== main.frg
#include <stdio>

int countDown(int from) {
    int steps = 0;
    do {
        from--;
        steps++;
    } while (from > 0);
    return steps;
}

int firstBig(list<int> xs) {
    int i = 0;
    do {
        if (xs[i] > 10) {
            return xs[i];
        }
        i++;
    } while (true);
}

int main(){
    // The code runs once even when the condition is false from the start.
    int n = 100;
    do {
        print("ran once: {n}");
    } while (n < 10);

    print(countDown(3));
    print(countDown(0));

    // break and continue work like in while.
    int i = 0;
    do {
        i++;
        if (i == 2) {
            continue;
        }
        if (i == 5) {
            break;
        }
        print(i);
    } while (i < 10);

    print(firstBig([3, 7, 12, 20]));

    // The word form of the condition works too.
    int tries = 0;
    do {
        tries++;
    } while (tries less 3);
    print(tries);
    return 0;
}
=== output
ran once: 100
3
1
1
3
4
12
3
=== no warnings
