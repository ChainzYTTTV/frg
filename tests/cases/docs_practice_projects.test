=== main.frg
#include <window>
#include <graphics2d>
#include <input>
#include <random>
#include <math>
#include <stdio>

struct Ball {
    vec2 position;
    vec2 velocity;
    color tint;
}

struct Entry {
    string name;
    int score;
}

list<Ball> balls = [];
vec2 position = vec2(400, 225);
vec2 velocity = vec2(200, 150);
float RADIUS = 20;
float spawnTimer = 0;
list<vec2> stars = [];
int lives = 3;
list<vec2> snake = [vec2(5, 5), vec2(4, 5)];
vec2 direction = vec2(1, 0);
list<rect> bricks = [];
bool visible = true;
list<list<int>> LINES = [[0, 1, 2], [3, 4, 5], [6, 7, 8], [0, 3, 6], [1, 4, 7], [2, 5, 8], [0, 4, 8], [2, 4, 6]];
list<string> board = [" ", " ", " ", " ", " ", " ", " ", " ", " "];

int main(){
    balls.add(Ball(vec2(10, 10), vec2(1, 1), color(uint8(random.range(50, 255)), uint8(random.range(50, 255)), uint8(random.range(50, 255)))));
    balls[0].position = vec2(50, 60);
    for (Ball b in balls) {
        b.position = vec2(0, 0);
    }
    print(balls[0].position);
    vec2 head = snake[0] + direction;
    snake.insert(0, head);
    snake.pop();
    print(snake);
    print(snake[0] == vec2(6, 5));
    for (int row = 0; row < 5; row++) {
        for (int col = 0; col < 10; col++) {
            bricks.add(rect(col * 80 + 2, row * 30 + 40, 76, 26));
        }
    }
    print(bricks.length);
    board[4] = "X";
    board[0] = "X";
    board[8] = "X";
    print(hasWon("X"));
    print(!board.contains(" "));
    int score = 7;
    print(float(score) / 10 * 100);
    int hp = 3;
    int damage = random.range(5 - 2, 5 + 2);
    print(math.max(0, hp - damage));
    string choice = "1";
    switch (choice) {
        case "1":
            print("one");
        case "4":
            print("four");
    }
    list<string> parts = "Ana,120".split(",");
    print(int(parts[1]));
    print("  North ".trim().lower());
    list<Entry> table = [];
    table.add(Entry("Ana", 120));
    table.insert(0, Entry("Bo", 200));
    print(table);
    float cookies = 12.7;
    int helpers = 2;
    list<string> lines = ["{cookies}", "{helpers}"];
    print(lines);
    print(vec2(math.cos(0), math.sin(0)));
    print(window.width() >= 0);
    return 0;
}

bool hasWon(string mark){
    for (list<int> line in LINES) {
        if (board[line[0]] == mark and board[line[1]] == mark and board[line[2]] == mark) {
            return true;
        }
    }
    return false;
}

void update(float dt){
    position += velocity * dt;
    if (position.x < RADIUS or position.x > window.width() - RADIUS) {
        velocity.x = -velocity.x;
    }
    if (position.y < RADIUS or position.y > window.height() - RADIUS) {
        velocity.y = -velocity.y;
    }
    spawnTimer += dt;
    if (spawnTimer >= 1) {
        spawnTimer -= 1;
        stars.add(vec2(random.range(20, window.width() - 20), -20));
    }
    for (int i = stars.length - 1; i >= 0; i--) {
        if (stars[i].y > window.height()) {
            stars.removeAt(i);
            lives--;
        }
    }
    float x = (window.width() - graphics2d.textWidth("hi", 40)) / 2;
    rect ballRect = rect(position.x - 10, position.y - 10, 20, 20);
    print(ballRect.overlaps(rect(0, 0, 10, 10)));
    print(input.mousePressed(MouseButton.LEFT) and input.mousePosition().distance(vec2(1, 1)) < 3);
}

void draw(){
    graphics2d.drawCircle(position, RADIUS, color.ORANGE);
}

task flash(){
    for (int i = 0; i < 6; i++) {
        visible = !visible;
        wait(0.15);
    }
    visible = true;
}
