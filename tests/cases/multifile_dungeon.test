=== main.frg
#include <"creatures">
#include <"items">
#include <"world">
#include <stdio>
#include <tasks>

int counted = 0;

int main(){
    print("== Forge multi-file test ==");
    world.combat.listeners.add((string text) { print("[log] " + text); });
    world.combat.listeners.add((string text) { counted++; });

    // Fights in every room: inheritance, interfaces, is/as and function values across files.
    hero.Hero ana = hero.Hero();
    list<world.dungeon.Room> path = [world.dungeon.Room.Entrance, world.dungeon.Room.Hall, world.dungeon.Room.Lair];
    int totalRounds = 0;
    for (int r in 0..path.length - 1) {
        world.dungeon.visit(world.dungeon.NAMES[r]);
        for (creatures.creature.Creature foe in world.dungeon.monstersIn(path[r])) {
            totalRounds += world.combat.fight(ana, foe);
            ana.purse += items.money.Money(1, 7);
        }
    }
    world.dungeon.visit("Hall");
    print(ana);
    print("purse: {ana.purse}");
    print("rounds: {totalRounds}, log lines: {counted}");
    print("creatures made: {creatures.creature.Creature.made}");
    print("visits: {world.dungeon.visits}");
    print("secret + 1: {world.dungeon.secretPlusOne()}");

    // Operators on a struct from another file.
    list<items.money.Money> coins = [items.money.Money(2, 5), items.money.Money(0, 9), items.money.Money(1, 0)];
    coins.sort();
    print("sorted coins: {coins}");
    print("1g 0s > 0g 9s: {items.money.Money(1, 0) > items.money.Money(0, 9)}");

    // A generic class from another file.
    items.bag.Bag<string> loot = items.bag.Bag(2);
    bool sword = loot.put("sword");
    bool shield = loot.put("shield");
    bool potion = loot.put("potion");
    print("put: {sword} {shield} {potion}, holding {loot.count()}");

    // An error thrown in one file, caught in another.
    try {
        ana.hit(-5);
    } catch (Error e) {
        print("caught: {e.message}");
    }

    // describe on a class that inherits across files.
    print("describe: {ana.describe.name}, parent {ana.describe.parent}");

    // Ranges and list function values.
    list<int> numbers = [];
    for (int i in 1..10) {
        numbers.add(i);
    }
    list<int> evens = numbers.filter((int n) { return n % 2 == 0; });
    print("evens: {evens}");
    list<creatures.creature.Creature> lineup = world.dungeon.monstersIn(world.dungeon.Room.Hall);
    lineup.add(creatures.slime.Slime("Tiny"));
    lineup.sortBy((creatures.creature.Creature c) { return c.hp; });
    print("by hp: {lineup[0].name} first");

    // A weak reference lets an object go.
    creatures.slime.Slime? temp = creatures.slime.Slime("Temp");
    Weak<creatures.slime.Slime> w = Weak(temp);
    print("weak before: {w.get() != null}");
    temp = null;
    print("weak after: {w.get() == null}");

    // A task from another file, run to the end.
    world.combat.countdown();
    tasks.runAll();
    print("log lines now: {counted}");
    return 0;
}
