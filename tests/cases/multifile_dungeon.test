=== creatures/creature.frg
#include <math>
#include <"bosses">

interface Fighter {
    int attackPower();
}

abstract class Creature {
    string name;
    int hp;
    static int made = 0;

    Creature(string name, int hp){
        this.name = name;
        this.hp = hp;
        made++;
    }

    abstract string kind();

    bool alive(){
        return hp > 0;
    }

    void hit(int damage){
        if (damage < 0) {
            throw "{name} can't take negative damage";
        }
        hp = math.max(0, hp - damage);
    }

    string toText(){
        return "{kind()} {name} ({hp} hp)";
    }
}
