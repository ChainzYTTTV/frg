=== items/bag.frg
class Bag<T> {
    list<T> items = [];
    int limit;

    Bag(int limit){
        this.limit = limit;
    }

    bool put(T item){
        if (items.length >= limit) {
            return false;
        }
        items.add(item);
        return true;
    }

    int count(){
        return items.length;
    }
}
=== items/money.frg
struct Money {
    int gold;
    int silver;

    Money plus(Money other){
        int total = toSilver() + other.toSilver();
        return Money(total / 10, total % 10);
    }

    int toSilver(){
        return gold * 10 + silver;
    }

    bool less(Money other){
        return toSilver() < other.toSilver();
    }

    string toText(){
        return "{gold}g {silver}s";
    }
}
=== world/combat.frg
list<Function<void(string)>> listeners = [];

void say(string text){
    for (Function<void(string)> f in listeners) {
        f(text);
    }
}

// Fights until one side is down, and gives back how many rounds it took.
int fight(hero.Hero h, creatures.creature.Creature foe){
    int rounds = 0;
    while (h.alive() and foe.alive()) {
        rounds++;
        foe.hit(h.attackPower());
        if (foe.alive() and foe is creatures.creature.Fighter) {
            creatures.creature.Fighter? f = foe as creatures.creature.Fighter;
            if (f != null) {
                h.hit(f.attackPower());
            }
        }
    }
    say("{h.name} vs {foe.name}: {rounds} rounds");
    return rounds;
}

task countdown(){
    for (int i in 1..3) {
        say("tick {i}");
        wait(0.01);
    }
}
=== world/dungeon.frg
enum Room { Entrance, Hall, Lair }

list<string> NAMES = ["Entrance", "Hall", "Lair"];
map<string, int> visits = {};
private int secret = 42;

list<creatures.creature.Creature> monstersIn(Room room){
    switch (room) {
        case Room.Entrance:
            return [creatures.slime.Slime("Blob")];
        case Room.Hall:
            return [creatures.goblin.Goblin("Grub"), creatures.goblin.Goblin("Snik")];
        case Room.Lair:
            return [creatures.bosses.dragon.Dragon()];
    }
    return [];
}

void visit(string name){
    if (visits.has(name)) {
        visits[name] += 1;
    } else {
        visits[name] = 1;
    }
}

int secretPlusOne(){
    return secret + 1;
}
