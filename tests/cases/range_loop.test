=== main.frg
#include <stdio>

int main(){
    for (int i in 0..3) {
        print(i);
    }
    int n = 2;
    int total = 0;
    for (int i in 1..n * 2) {
        total += i;
    }
    print(total);
    for (int i in 5..4) {
        print("never");
    }
    for (int i in 7..7) {
        print("once: {i}");
    }
    list<string> names = ["Ana", "Bo", "Cy"];
    for (int i in 0..names.length - 1) {
        if (i == 1) {
            continue;
        }
        print("{i}: {names[i]}");
    }
    for (int i in -2..10) {
        if (i == 0) {
            break;
        }
        print(i);
    }
    for (int8 i in 125..127) {
        print(i);
    }
    for (uint8 i in 254..255) {
        print(i);
    }
    for (int i = 0; i < 2; i++) {
        print("c-style {i}");
    }
    return 0;
}
