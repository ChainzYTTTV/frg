=== main.frg
#include <stdio>

int main(){
    float speed = 3.14159;
    double big = 2.0 / 3.0;
    bool fast = true;
    map<string, float> m = {"a": 1.5};
    print("{speed:.2}");
    print("{speed:.0} | {big:.4} | {speed : .1}");
    print("{fast ? speed : big:.3}");
    print("{fast ? 1 : 2}");
    print("{m["a"]:.1} and {5:.2}");
    print("{{not a value:.2}}");
    return 0;
}
=== output
3.14
3 | 0.6667 | 3.1
3.142
1
1.5 and 5.00
{not a value:.2}
