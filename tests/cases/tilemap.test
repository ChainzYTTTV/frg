=== main.frg
#include <stdio>
#include <tilemap>
#include <physics>

int main(){
    TileMap level = TileMap("""
##########
#P   C   #
#   ===  #
##########
""", 10);
    print(level);
    print("{level.columns()} x {level.rows()}, {level.width()} x {level.height()}");
    print(level.get(1, 1) + level.get(5, 1) + "[" + level.get(50, 50) + "]");
    print(level.find("P"));
    print(level.find("C="));

    // Walls are merged into 4 boxes, not 24 single tiles.
    list<rect> walls = level.solidAreas("#");
    print(walls.length);
    print(walls);

    list<Body> bodies = level.addBodies("#");
    list<Body> ledges = level.addBodies("=", true);
    print("{bodies.length} {ledges.length} {physics.count()} {bodies[0].isStatic} {ledges[0].oneWay}");

    level.set(5, 1, " ");
    print(level.find("C").length);
    print("{level.columnAt(25)} {level.rowAt(-1)} {level.tileRect(2, 3)}");
    return 0;
}
