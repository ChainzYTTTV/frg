=== main.frg
#include <Vulkan>
#include <stdio>

int main(){
    print(Vulkan.TRIANGLES);
    print(Vulkan.CULL_BACK);
    list<float> p = Vulkan.perspective(90, 1, 1, 3);
    print(p[5]);
    print(p[10]);
    print(Vulkan.multiply(Vulkan.identity(), Vulkan.translate(vec3(1, 2, 3)))[13]);
    return 0;
}
