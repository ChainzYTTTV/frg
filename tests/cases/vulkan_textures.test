=== main.frg
#include <Vulkan>
#include <stdio>

int main(){
    Vulkan.openWindow(640, 360, "Textured");
    int vs = Vulkan.loadShader("quad.vert.spv");
    int fs = Vulkan.loadShader("quad.frag.spv");
    // Each corner: 2 floats of position, then 2 of texture coordinates ((0, 0) is the picture's top-left).
    Vulkan.setBlending(true);     // a setting for the pipelines made after it
    int pipeline = Vulkan.createPipeline(vs, fs, [2, 2]);
    int blob = Vulkan.loadTexture("blob.png");
    print("texture handle: {blob}");
    // two squares: smooth on the left, sharp pixels on the right (y is down in Vulkan's screen space)
    int left = Vulkan.createVertexBuffer([-0.9, -0.6, 0, 0, -0.1, -0.6, 1, 0, -0.1, 0.6, 1, 1, -0.9, -0.6, 0, 0, -0.1, 0.6, 1, 1, -0.9, 0.6, 0, 1]);
    int right = Vulkan.createVertexBuffer([0.1, -0.6, 0, 0, 0.9, -0.6, 1, 0, 0.9, 0.6, 1, 1, 0.1, -0.6, 0, 0, 0.9, 0.6, 1, 1, 0.1, 0.6, 0, 1]);
    try {
        Vulkan.loadTexture("missing.png");
    } catch (Error e) {
        print("missing: {e.message}");
    }
    while (!Vulkan.shouldClose()) {
        if (Vulkan.beginFrame(0.15, 0.15, 0.2, 1)) {
            Vulkan.bindPipeline(pipeline);
            Vulkan.setTextureFilter(true);
            Vulkan.bindTexture(blob);
            Vulkan.bindVertexBuffer(left);
            Vulkan.draw(6);
            Vulkan.setTextureFilter(false);
            Vulkan.bindTexture(blob);
            Vulkan.bindVertexBuffer(right);
            Vulkan.draw(6);
            Vulkan.endFrame();
        }
    }
    print("done");
    Vulkan.closeWindow();
    return 0;
}
=== quad.vert
#version 450
layout(location = 0) in vec2 position;
layout(location = 1) in vec2 uv;
layout(location = 0) out vec2 vUv;
void main() {
    gl_Position = vec4(position, 0.0, 1.0);
    vUv = uv;
}
=== quad.frag
#version 450
layout(location = 0) in vec2 vUv;
layout(set = 0, binding = 0) uniform sampler2D picture;
layout(location = 0) out vec4 outColor;
void main() {
    outColor = texture(picture, vUv);
}
