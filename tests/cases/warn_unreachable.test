#include <stdio>

int pick(int n) {
    return n;
    print("never");
}

int main(){
    for (int i = 0; i < 3; i++) {
        break;
        print(i);
    }
    while (true) {
        if (pick(1) == 1) {
            break;
        }
        continue;
        print("never");
    }
    print(pick(2));
    return 0;
}
