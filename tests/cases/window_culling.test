=== main.frg
#include <window>
#include <graphics3d>
#include <stdio>

``` Culling: things entirely outside what the camera sees aren't drawn (and are counted); pushTransform is followed. ```

int frame = 0;

int main(){
    print(graphics3d.isCulling());
    window.open(400, 300, "culling");
    window.run();
    return 0;
}

void update(float dt){
    if (frame == 3) {
        graphics3d.setCulling(false);
    }
}

void draw(){
    print("frame {frame}: {graphics3d.culledLastFrame()} culled last frame");
    graphics3d.setCamera(Camera(vec3(0, 0, 0), vec3(0, 0, 1)));
    graphics3d.drawCube(vec3(0, 0, 5), vec3(1, 1, 1), color.RED);       // in front: drawn
    graphics3d.drawCube(vec3(0, 0, -5), vec3(1, 1, 1), color.RED);      // behind: culled
    graphics3d.drawSphere(vec3(60, 0, 5), 1, color.RED);                // far to the side: culled
    graphics3d.drawCylinder(vec3(0, -1, 3), 0.5, 2, color.RED);         // in front: drawn
    // in front of where it's drawn, but pushTransform turns it half way round, behind the camera: culled
    graphics3d.pushTransform(vec3.ZERO, vec3.UP, 180);
    graphics3d.drawCube(vec3(0, 0, 5), vec3(1, 1, 1), color.BLUE);
    graphics3d.popTransform();
    // a big plane under everything is partly in view: drawn
    graphics3d.drawPlane(vec3(0, -2, 0), vec2(100, 100), color.GRAY);
    frame++;
}
