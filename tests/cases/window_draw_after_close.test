#include <window>
#include <graphics2d>

``` Drawing after window.close() says the window was closed (not that it was never opened). ```
int main(){
    window.open(320, 200, "Closed");
    while (!window.shouldClose()) {
        window.close();
        graphics2d.drawRect(10, 10, 20, 20, color.RED);
    }
    return 0;
}
