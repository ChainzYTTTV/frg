=== main.frg
#include <window>
#include <stdio>

``` A try { } in update catches the error, and the game keeps running. ```
int frames = 0;
list<int> scores = [];

int main(){
    window.open(320, 200, "Caught");
    window.run();
    print("still ran all {frames} frames");
    return 0;
}

void update(float dt){
    frames++;
    if (frames == 3) {
        try {
            int best = scores[0];
        } catch (Error e) {
            print("caught: {e.message}");
        }
    }
}

void draw(){
}
