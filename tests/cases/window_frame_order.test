=== main.frg
#include <window>
#include <stdio>

``` The order of one frame: waiting tasks wake up, then update(dt), then draw(). dt is 0 on the first frame. ```
int frame = 0;

task ticker(){
    for (int i in 1..3) {
        print("  task (frame {frame})");
        wait(0);
    }
}

int main(){
    window.open(320, 200, "Order");
    ticker();
    print("before run");
    window.run();
    print("after run: {frame} frames");
    return 0;
}

void update(float dt){
    print("update {frame}" + (dt > 0 ? "" : " (dt is 0)"));
}

void draw(){
    print("draw {frame}");
    frame++;
}
=== window
frames: 3
