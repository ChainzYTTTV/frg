=== main.frg
#include <window>
#include <input>
#include <stdio>

``` keyPressed is true on the first frame a key is down, keyDown on every frame it's down, keyReleased on the frame after. ```
int frame = 0;

int main(){
    window.open(320, 200, "Keys");
    window.run();
    return 0;
}

void update(float dt){
    string s = "";
    if (input.keyPressed(Key.SPACE)) { s += " pressed"; }
    if (input.keyDown(Key.SPACE)) { s += " down"; }
    if (input.keyReleased(Key.SPACE)) { s += " released"; }
    if (input.mousePressed(MouseButton.LEFT)) { s += " click"; }
    if (input.keyDown(Key.A) and input.keyDown(Key.D)) { s += " A+D"; }
    print("frame {frame}:{s}");
    frame++;
}

void draw(){
}
