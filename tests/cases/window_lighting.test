=== main.frg
#include <window>
#include <graphics3d>
#include <assets>
#include <graphics2d>
#include <stdio>

``` setLight lights every shape, mesh and model (lines and outlines stay unlit); lightOff turns it off again. ```

int frame = 0;
Texture tiles = assets.loadTexture("tiles.png");
Mesh? ground = null;

int main(){
    print(graphics3d.isLit());
    window.open(400, 300, "light");
    try {
        graphics3d.setLight(vec3.ZERO);
    } catch (Error e) {
        print("zero: {e.message}");
    }
    graphics3d.setLight(vec3(-0.5, -1, -0.3), color(255, 250, 240), color(90, 90, 100));
    print(graphics3d.isLit());
    // a mesh: two triangles (a square floor), lit by its own normals
    list<float> p = [0, 0, 0, 0, 0, 2, 2, 0, 2, 0, 0, 0, 2, 0, 2, 2, 0, 0];
    list<float> uv = [0, 0, 0, 1, 1, 1, 0, 0, 1, 1, 1, 0];
    ground = graphics3d.makeMesh(p, uv, [], tiles);
    window.run();
    return 0;
}

void update(float dt){
    if (frame == 2) {
        graphics3d.lightOff();
        print("off: {graphics3d.isLit()}");
    }
    if (frame == 4) {
        graphics3d.setLight(vec3(0, -1, 0));
        print("on again: {graphics3d.isLit()}");
    }
}

void draw(){
    graphics3d.setCamera(Camera(vec3(3, 3, -4), vec3(0, 0, 0)));
    graphics3d.drawPlane(vec3.ZERO, vec2(10, 10), color.GREEN);
    graphics3d.drawCube(vec3(0, 0.5, 0), vec3.ONE, color.RED);
    graphics3d.pushTransform(vec3(-1.5, 0.5, 0), vec3.UP, 30);
    graphics3d.drawCube(vec3.ZERO, vec3.ONE, color.WHITE);
    graphics3d.popTransform();
    graphics3d.drawSphere(vec3(1.5, 0.5, 0), 0.5, color.BLUE);
    graphics3d.drawSphere(vec3(1.5, 1.5, 0), 0.4, color(200, 200, 200, 100));     // see-through
    graphics3d.drawCylinder(vec3(0, 0, 1.5), 0.3, 1, color.YELLOW);
    graphics3d.drawLine(vec3(-2, 0.01, -1), vec3(2, 0.01, -1), color.BLACK);
    graphics3d.drawCubeOutline(vec3(0, 0.5, 0), vec3(1.1, 1.1, 1.1), color.WHITE);
    graphics3d.drawSphereOutline(vec3(1.5, 0.5, 0), 0.55, color.WHITE);
    graphics3d.drawGrid(10, 1);
    if (ground != null) {
        ground.draw(vec3(-1, 0.02, -3));
    }
    graphics2d.drawText("frame {frame}", 10, 10, 20, color.WHITE);
    frame++;
}
