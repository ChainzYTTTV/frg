=== main.frg
#include <window>
#include <graphics2d>
#include <stdio>

``` window.close() in update: update finishes, draw is skipped that frame (the window is gone), and run() returns. ```
int frames = 0;

int main(){
    window.open(320, 200, "Quit from update");
    window.run();
    print("run() returned after {frames} updates, {drawn} draws");
    return 0;
}

int drawn = 0;

void update(float dt){
    frames++;
    if (frames == 3) {
        window.close();
        print("update carries on after close()");
    }
}

void draw(){
    drawn++;
    graphics2d.drawRect(10, 10, 20, 20, color.RED);
}
=== window
frames: 60
=== output
update carries on after close()
run() returned after 3 updates, 2 draws
