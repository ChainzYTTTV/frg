=== main.frg
#include <window>
#include <input>
#include <stdio>

``` FRG_AUTOTEST_INPUT can move the pointer (MOUSE@x/y) and the mouse (TURN@dx/dy), so menus and mouse-look can be tested. ```

int frame = 0;

int main(){
    window.open(400, 300, "mouse");
    window.run();
    return 0;
}

void update(float dt){
    vec2 p = input.mousePosition();
    vec2 d = input.mouseDelta();
    string click = input.mousePressed(MouseButton.LEFT) ? " click" : "";
    print("frame {frame}: at {p.x}/{p.y} moved {d.x}/{d.y}{click}");
    frame++;
}

void draw(){
}
