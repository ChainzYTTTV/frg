=== main.frg
#include <window>
#include <graphics2d>
#include <stdio>

``` After window.run() returns, the window is closed: shouldClose() is true, and drawing is an error. ```
int main(){
    window.open(320, 200, "After");
    window.run();
    print("shouldClose(): {window.shouldClose()}");
    try {
        graphics2d.drawRect(0, 0, 10, 10, color.RED);
    } catch (Error e) {
        print("drawing: {e.message}");
    }
    return 0;
}

void update(float dt){
}

