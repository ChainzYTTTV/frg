=== main.frg
#include <window>
#include <input>
#include <stdio>

``` The side (thumb) mouse buttons: MouseButton.BACK and MouseButton.FORWARD, scripted as MOUSE_BACK / MOUSE_FORWARD. ```

int frame = 0;

int main(){
    print(MouseButton.BACK);
    print(MouseButton.FORWARD);
    print(int(MouseButton.FORWARD));
    window.open(400, 300, "side buttons");
    window.run();
    return 0;
}

void update(float dt){
    string s = "frame {frame}:";
    for (MouseButton b in [MouseButton.BACK, MouseButton.FORWARD]) {
        if (input.mousePressed(b)) {
            s += " {b} pressed";
        }
        if (input.mouseDown(b)) {
            s += " {b} down";
        }
        if (input.mouseReleased(b)) {
            s += " {b} released";
        }
    }
    print(s);
    frame++;
}

void draw(){
}
