=== main.frg
#include <window>
#include <graphics3d>
#include <graphics2d>
#include <stdio>

``` pushTransform needs a popTransform before 2D drawing (or the end of the frame); popTransform needs a push. ```
int main(){
    window.open(320, 200, "Transforms");
    while (!window.shouldClose()) {
        try {
            graphics3d.popTransform();
        } catch (Error e) {
            print("pop alone: {e.message}");
        }
        graphics3d.pushTransform(vec3(1, 0, 0), vec3.UP, 45);
        graphics3d.drawCube(vec3.ZERO, vec3.ONE, color.RED);
        graphics2d.drawText("2D while pushed", 10, 10, 20, color.WHITE);
    }
    return 0;
}
=== window
frames: 5
=== output
pop alone: there's no pushTransform() to undo - each popTransform() goes with one pushTransform() before it
